# ========================================================
# KONFIGURASI KONEKSI SSH DEPLOYMENT (HOSTINGER / VPS / CPANEL)
# Salin file ini menjadi: .deploy.env
# File .deploy.env sudah otomatis di-ignore oleh Git (.gitignore)
# ========================================================

# Host / IP Server (Contoh Hostinger: connect.hostinger.com atau 195.35.x.x)
SSH_HOST="connect.hostinger.com"

# Port SSH (Hostinger Shared Hosting biasanya 65002, VPS biasanya 22)
SSH_PORT="65002"

# Username SSH di hPanel / server (Contoh: u123456789 atau root)
SSH_USER="u123456789"

# Lokasi folder web di server (Hostinger default: public_html)
REMOTE_PATH="public_html"

# Path ke private key SSH jika tidak menggunakan password (Opsional, kosongkan jika default ~/.ssh/id_rsa)
SSH_KEY_PATH=""
