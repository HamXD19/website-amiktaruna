    {{-- =========================================
         FUNCTION CARD
    ========================================== --}}

@php
function renderBeritaCard($items) {
    foreach($items->take(3) as $b) {
@endphp

<div class="col-md-4">

    <div class="berita-card h-100 overflow-hidden">

        {{-- MEDIA --}}
        <div class="berita-media">

            @if($b->gambar)

                <img src="{{ asset('uploads/berita/gambar/'.$b->gambar) }}"
                     class="berita-img"
                     alt="{{ $b->judul }}">

            @elseif($b->video)

                <video controls class="berita-video">

                    <source
                        src="{{ asset('uploads/berita/video/'.$b->video) }}"
                        type="video/mp4">

                </video>

            @endif

        </div>

        {{-- BODY --}}
        <div class="card-body">

            <p class="berita-title">
                {{ $b->judul }}
            </p>

            <div class="berita-date">
                <i class="fas fa-calendar-alt"></i>

                {{ $b->publish_at
                    ? $b->publish_at->format('d M Y')
                    : $b->created_at->format('d M Y') }}
            </div>

            <a href="{{ url('/berita/'.$b->slug) }}"
               class="btn-baca">

                Baca Selengkapnya

            </a>

        </div>

    </div>

</div>

@php
    }
}
@endphp



