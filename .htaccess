# ========================================================
# ROOT .HTACCESS - AMIK TARUNA PROBOLINGGO
# Keamanan Ketat & Pengalihan ke Folder public/
# ========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Matikan Directory Browsing / Indexing
    Options -Indexes

    # Blokir akses langsung ke direktori sistem Laravel
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|vendor|tests)(/.*)?$ - [F,L,NC]

    # Blokir akses langsung ke file sensitif dan arsip
    <FilesMatch "(^\.(env|git|json|lock|editorconfig)|(?i)\.(sh|sql|rar|zip|tar\.gz|bak|log|xml|md)|artisan|composer\.(json|lock)|package(-lock)?\.json)$">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </FilesMatch>

    # Arahkan seluruh request ke folder public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
