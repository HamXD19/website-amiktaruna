# ========================================================
# UPLOADS SECURITY .HTACCESS
# Mencegah eksekusi script / webshell di direktori uploads
# ========================================================

# Matikan Directory Browsing dan eksekusi CGI
Options -Indexes -ExecCGI

# Blokir seluruh file skrip eksekutabel secara ketat (mencegah webshell / malware)
<FilesMatch "(?i)\.(php|phtml|phar|php[0-9]?|cgi|pl|sh|bash|py|rb|asp|aspx|jsp|exe|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Pastikan file dokumen (PDF, Word, Excel, Gambar) dapat diunduh langsung tanpa blokir
<FilesMatch "(?i)\.(pdf|doc|docx|xls|xlsx|ppt|pptx|txt|rtf|csv|jpg|jpeg|png|gif|webp|svg|ico)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>
