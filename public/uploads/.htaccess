# ========================================================
# UPLOADS SECURITY .HTACCESS
# Mencegah eksekusi script / webshell di direktori uploads
# ========================================================

# Matikan Directory Browsing dan eksekusi CGI
Options -Indexes -ExecCGI

# Matikan engine PHP jika modul PHP Apache aktif
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Blokir seluruh file skrip eksekutabel secara ketat
<FilesMatch "(?i)\.(php|phtml|phar|php[0-9]?|cgi|pl|sh|bash|py|rb|asp|aspx|jsp|exe|shtml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
